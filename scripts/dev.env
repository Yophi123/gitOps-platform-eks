# The one file to edit per environment. Read by the Makefile and scripts/render.sh.
# KEY=value only, no quotes, no comments on the same line as a value.

ENV=dev
AWS_REGION=ap-southeast-1
CLUSTER_NAME=gitops-eks-dev

# Git repository Argo CD syncs from (same value as gitops_repo_url in terraform.tfvars)
GITOPS_REPO_URL=https://github.com/Yophi123/gitOps-platform-eks.git
GITOPS_REVISION=main

# Chart versions. Keep CILIUM/KARPENTER/ARGOCD equal to the matching terraform.tfvars
# values; render.sh warns when they differ.
CILIUM_VERSION=1.20.2
KARPENTER_VERSION=1.15.0
ARGOCD_CHART_VERSION=10.10.5
# helm search repo external-secrets/external-secrets  (CHART VERSION column)
ESO_CHART_VERSION=2.13.0
# helm search repo prometheus-community/kube-prometheus-stack
PROM_STACK_CHART_VERSION=92.10.1
# helm search repo argo/argo-rollouts
ROLLOUTS_CHART_VERSION=2.43.8
