# Rendered by scripts/render.sh from Terraform outputs. Edit the template
# (scripts/templates/platform/karpenter/ec2nodeclass.yaml.tmpl), not this file.
apiVersion: karpenter.k8s.aws/v1
kind: EC2NodeClass
metadata:
  name: default
spec:
  role: @@KARPENTER_NODE_ROLE@@

  # Pin a version in prod (al2023@vYYYYMMDD) so AMI rollouts are deliberate
  amiSelectorTerms:
    - alias: al2023@latest

  # App tier only: the karpenter.sh/discovery tag is on the app subnets
  subnetSelectorTerms:
    - tags:
        karpenter.sh/discovery: @@CLUSTER_NAME@@
  # EKS cluster SG (tagged by the eks module); Cilium's pod ENIs inherit it
  securityGroupSelectorTerms:
    - tags:
        karpenter.sh/discovery: @@CLUSTER_NAME@@

  metadataOptions:
    httpEndpoint: enabled
    httpTokens: required
    httpPutResponseHopLimit: 1 # pods can't reach node credentials

  blockDeviceMappings:
    - deviceName: /dev/xvda
      ebs:
        volumeSize: 50Gi
        volumeType: gp3
        encrypted: true
        deleteOnTermination: true

  tags:
    Project: gitops-eks
    ManagedBy: karpenter
