apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: karpenter
  namespace: argocd
  annotations:
    argocd.argoproj.io/sync-wave: "1"
spec:
  project: platform
  destination:
    server: https://kubernetes.default.svc
    namespace: kube-system
  sources:
    - repoURL: public.ecr.aws/karpenter
      chart: karpenter
      targetRevision: @@KARPENTER_VERSION@@
      helm:
        releaseName: karpenter
        skipCrds: true # owned by the karpenter-crd Application
        valueFiles:
          - $values/gitops/envs/@@ENV@@/values/karpenter.yaml
    - repoURL: @@GITOPS_REPO_URL@@
      targetRevision: @@GITOPS_REVISION@@
      ref: values
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    retry:
      limit: 10
      backoff:
        duration: 15s
        factor: 2
        maxDuration: 5m
    syncOptions:
      - CreateNamespace=true
      - ServerSideApply=true
