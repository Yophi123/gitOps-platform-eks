apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: podinfo
  namespace: argocd
  annotations:
    argocd.argoproj.io/sync-wave: "6" # after Rollouts' CRDs and Prometheus
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: apps
  destination:
    server: https://kubernetes.default.svc
    namespace: podinfo
  source:
    repoURL: @@GITOPS_REPO_URL@@
    targetRevision: @@GITOPS_REVISION@@
    path: gitops/apps/podinfo
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    retry:
      limit: 10
      backoff:
        duration: 15s
        factor: 2
        maxDuration: 5m
    syncOptions:
      - CreateNamespace=true
      - ServerSideApply=true