apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: demo
  namespace: argocd
  annotations:
    argocd.argoproj.io/sync-wave: "5" # after ESO's CRDs; retry covers any race
  finalizers:
    - resources-finalizer.argocd.argoproj.io # workloads: deleting the app cleans up
spec:
  project: apps
  destination:
    server: https://kubernetes.default.svc
    namespace: demo
  source:
    repoURL: @@GITOPS_REPO_URL@@
    targetRevision: @@GITOPS_REVISION@@
    path: gitops/apps/demo
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    retry:
      limit: 10
      backoff:
        duration: 15s
        factor: 2
        maxDuration: 5m
    syncOptions:
      - CreateNamespace=true
      - ServerSideApply=true
