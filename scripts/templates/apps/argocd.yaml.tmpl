apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: argocd
  namespace: argocd
  annotations:
    argocd.argoproj.io/sync-wave: "10"
spec:
  project: platform
  destination:
    server: https://kubernetes.default.svc
    namespace: argocd
  sources:
    - repoURL: https://argoproj.github.io/argo-helm
      chart: argo-cd
      targetRevision: @@ARGOCD_CHART_VERSION@@ # same as argocd_chart_version in terraform.tfvars
      helm:
        releaseName: argocd
        valueFiles:
          - $values/gitops/envs/@@ENV@@/values/argocd.yaml
    - repoURL: @@GITOPS_REPO_URL@@
      targetRevision: @@GITOPS_REVISION@@
      ref: values
  syncPolicy:
    automated:
      prune: false
      selfHeal: true
    retry:
      limit: 10
      backoff:
        duration: 15s
        factor: 2
        maxDuration: 5m
    syncOptions:
      - CreateNamespace=true
      - ServerSideApply=true
