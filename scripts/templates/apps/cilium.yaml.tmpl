apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: cilium
  namespace: argocd
  annotations:
    argocd.argoproj.io/sync-wave: "0"
  # No finalizer: deleting this Application must never remove the CNI
spec:
  project: platform
  destination:
    server: https://kubernetes.default.svc
    namespace: kube-system
  sources:
    - repoURL: https://helm.cilium.io
      chart: cilium
      targetRevision: @@CILIUM_VERSION@@
      helm:
        releaseName: cilium # same as the Terraform bootstrap release
        valueFiles:
          - $values/gitops/envs/@@ENV@@/values/cilium.yaml
    - repoURL: @@GITOPS_REPO_URL@@
      targetRevision: @@GITOPS_REVISION@@
      ref: values
  syncPolicy:
    automated:
      prune: false
      selfHeal: true
    retry:
      limit: 10
      backoff:
        duration: 15s
        factor: 2
        maxDuration: 5m
    syncOptions:
      - CreateNamespace=true
      - ServerSideApply=true
