# Rendered by scripts/render.sh from Terraform outputs. Edit the template
# (scripts/templates/apps-demo/external-secret.yaml.tmpl), not this file.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: demo-db
  namespace: demo
spec:
  refreshInterval: 30m # new lease well before the 1h TTL
  target:
    name: demo-db
    template:
      engineVersion: v2
      mergePolicy: Merge # keep generated username/password, add the fields below
      data:
        DB_HOST: @@DEMO_DB_HOST@@
        DB_NAME: @@DEMO_DB_NAME@@
  dataFrom:
    - sourceRef:
        generatorRef:
          apiVersion: generators.external-secrets.io/v1alpha1
          kind: VaultDynamicSecret
          name: demo-db
