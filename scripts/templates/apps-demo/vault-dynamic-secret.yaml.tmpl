# Rendered by scripts/render.sh from Terraform outputs. Edit the template
# (scripts/templates/apps-demo/vault-dynamic-secret.yaml.tmpl), not this file.
apiVersion: generators.external-secrets.io/v1alpha1
kind: VaultDynamicSecret
metadata:
  name: demo-db
  namespace: demo
spec:
  path: /database/creds/demo
  method: GET
  resultType: Data # username + password from the lease data
  provider:
    server: @@DEMO_VAULT_ADDR@@
    caBundle: @@DEMO_VAULT_CA_BUNDLE@@
    auth:
      jwt:
        path: jwt-eks
        role: demo
        # Logs in as the app's own service account (Vault bound_subject)
        kubernetesServiceAccountToken:
          serviceAccountRef:
            name: demo-app
          audiences:
            - vault
