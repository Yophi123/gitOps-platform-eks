# Keep in sync with gitops/platform/karpenter/values.yaml.
# Argo CD adopts this release in stage 3 and must render identical values.

# Bootstrap copy. After stage 3, gitops/envs/<env>/values/<app>.yaml is the
# source of truth. Change values there; copy back here only to keep fresh
# bootstraps consistent.

settings:
  clusterName: ${cluster_name}
  interruptionQueue: ${queue_name}
  featureGates:
    # Replace underutilized Spot nodes with cheaper Spot nodes.
    # Off by default upstream; needs a flexible NodePool (we allow many families/sizes).
    spotToSpotConsolidation: true
replicas: ${replicas}

# Runs on the dedicated system nodes. The chart's default affinity already
# keeps it off nodes Karpenter itself launches.
tolerations:
  - key: CriticalAddonsOnly
    operator: Exists

controller:
  resources:
    requests:
      cpu: 250m
      memory: 512Mi
    limits:
      memory: 1Gi
